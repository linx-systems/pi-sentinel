{
  "name": "pisentinel",
  "version": "0.0.4",
  "description": "Browser extension for Pi-hole v6 integration",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ext": "web-ext lint --source-dir=dist/firefox-mv3",
    "lint:ext:chrome": "web-ext lint --source-dir=dist/chrome-mv3",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:setup": "cat tests/e2e/RUN_WITH_EXTENSION.md",
    "package:source": "./scripts/package-source.sh",
    "test:all": "bun run test:unit && bun run test:e2e",
    "package": "bun run build:firefox && cd dist/firefox-mv3 && zip -r ../../pisentinel.xpi .",
    "package:chrome": "bun run build && cd dist/chrome-mv3 && zip -r ../../pisentinel-chrome.zip .",
    "sign": "bun run build:firefox && web-ext sign --source-dir=dist/firefox-mv3 --api-key=$AMO_API_KEY --api-secret=$AMO_API_SECRET",
    "sign:channel": "bun run build:firefox && web-ext sign --source-dir=dist/firefox-mv3 --api-key=$AMO_API_KEY --api-secret=$AMO_API_SECRET --channel=unlisted",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.6",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "web-ext": "^9.4.0",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@linx-systems/pihole-api-client": "^0.1.2",
    "preact": "^10.29.8",
    "webextension-polyfill": "^0.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
